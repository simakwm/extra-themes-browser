#!/usr/bin/env python3
"""Backend for the Extra Themes popup. Every command prints JSON on stdout.

  catalog [--refresh]   list themes from omarchy.org with installed/favorite state
  status                installed git themes that are behind their upstream
  install <repo-url>    omarchy theme install
  uninstall <dir-name>  omarchy theme remove
  update <dir-name>     git pull --ff-only
  apply <dir-name>      omarchy theme set
  favorite <slug>       toggle favorite
  open-folder           open the user themes directory in the file manager
  settings              bar placement, menu entry and shortcut state
  bar <hidden|left|center|right>   put the bar icon in a section (or remove it)
  bar-move <-1|1>       nudge the bar icon within its section
  menu <on|off>         add/remove the Omarchy menu entry
  shortcut-set <combo>  register a Hyprland shortcut, e.g. "SUPER + CTRL + T"
  shortcut-clear        remove the shortcut
  notify <on|off>       notify when installed themes have new updates
  check-updates [--force]  (run hourly by the plugin's service) at most once a day, fetch
                        and notify about new theme updates
  cleanup               remove the bar icon, menu entry, shortcut, favorites and cache
"""
import concurrent.futures as cf
import fcntl
import html
import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.request

HOME = os.path.expanduser("~")
THEMES = f"{HOME}/.config/omarchy/themes"
CACHE = f"{os.environ.get('XDG_CACHE_HOME', HOME + '/.cache')}/extra-themes-browser"
STATE = f"{os.environ.get('XDG_STATE_HOME', HOME + '/.local/state')}/extra-themes-browser"
DEFAULT_THEME = "Tokyo Night"   # what Omarchy installs with
PLUGIN_ID = "io.github.simakwm.extra-themes"
SHELL_JSON = f"{HOME}/.config/omarchy/shell.json"
MENU_FILE = f"{HOME}/.config/omarchy/extensions/omarchy-menu.jsonc"
BINDINGS = f"{HOME}/.config/hypr/bindings.lua"
BIND_DESC = "Omarchy Extra Themes"
BIND_CMD = f"omarchy-shell shell toggle {PLUGIN_ID}"
MENU_ENTRY = (
    '"style.extra-themes": {"icon":"\U000F03D8","label":"Extra Themes","aliases":["extra-themes"],'
    f'"action":"omarchy-shell shell summon {PLUGIN_ID}"}},'
)
SOURCE = "https://omarchy.org"
TTL = 24 * 3600
ENTRY = re.compile(
    r'<li><a href="(https://github\.com/[^"]+)"[^>]*><img src="(/assets/themes/[^"]+)"[^>]*?/>'
    r'<span[^>]*>([^<]+)</span>'
)
SLUG_OK = re.compile(r"^[a-z0-9_][a-z0-9._+-]*$")


def slug_of(repo):
    """Same naming rule as omarchy-theme-install, so dirs line up."""
    name = os.path.basename(repo.rstrip("/"))
    name = re.sub(r"\.git$", "", name)
    name = re.sub(r"^omarchy-", "", name)
    name = re.sub(r"-theme$", "", name)
    return name.lower()


def fetch_catalog(refresh):
    path = f"{CACHE}/catalog.json"
    try:
        if not refresh and time.time() - os.path.getmtime(path) < TTL:
            return json.load(open(path))
    except (OSError, ValueError):
        pass
    try:
        req = urllib.request.Request(f"{SOURCE}/themes/", headers={"User-Agent": "extra-themes-browser"})
        with urllib.request.urlopen(req, timeout=20) as r:
            page = r.read(8 << 20).decode("utf-8", "replace")
        items = [
            {"name": html.unescape(n).strip(), "repo": u, "slug": slug_of(u), "image": SOURCE + i}
            for u, i, n in ENTRY.findall(page)
        ]
        if not items:
            raise ValueError("no themes found in page")
    except Exception:
        # Offline or page changed: fall back to a stale cache rather than nothing.
        try:
            return json.load(open(path))
        except (OSError, ValueError):
            raise
    os.makedirs(CACHE, exist_ok=True)
    write_atomic(path, json.dumps(items))
    return items


def favorites():
    try:
        return set(json.load(open(f"{STATE}/favorites.json")))
    except (OSError, ValueError):
        return set()


def is_git_theme(slug):
    d = f"{THEMES}/{slug}"
    return os.path.isdir(f"{d}/.git") and not os.path.islink(d)


def active_slug():
    """Folder name of the active theme. `omarchy theme current` only prettifies this
    file ("castle-on-a-lake" -> "Castle On A Lake"), so read the original."""
    try:
        with open(f"{HOME}/.local/state/omarchy/current/theme.name") as f:
            return f.read().strip()
    except OSError:
        return ""


def catalog(refresh):
    favs = favorites()
    active = active_slug()
    out = []
    for t in fetch_catalog(refresh):
        t["installed"] = os.path.isdir(f"{THEMES}/{t['slug']}")
        t["git"] = is_git_theme(t["slug"])
        t["active"] = t["slug"] == active
        t["favorite"] = t["slug"] in favs
        t["author"] = t["repo"].split("/")[3] if t["repo"].count("/") >= 4 else ""
        out.append(t)
    return out


def upstream_sha(slug):
    """Commit the theme's upstream is at if that is ahead of what is installed, '' if it is
    up to date, None if we could not tell (offline, timeout, a concurrent fetch)."""
    d = f"{THEMES}/{slug}"
    try:
        subprocess.run(["git", "-C", d, "fetch", "--quiet"], timeout=30, check=True,
                       stdin=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        n = subprocess.run(["git", "-C", d, "rev-list", "--count", "HEAD..@{u}"],
                           capture_output=True, text=True, timeout=10, check=True).stdout.strip()
        if int(n or 0) <= 0:
            return ""
        return subprocess.run(["git", "-C", d, "rev-parse", "@{u}"],
                              capture_output=True, text=True, timeout=10, check=True).stdout.strip()
    except Exception:
        return None


def status():
    slugs = [d for d in os.listdir(THEMES) if is_git_theme(d)] if os.path.isdir(THEMES) else []
    with cf.ThreadPoolExecutor(8) as ex:
        results = dict(zip(slugs, ex.map(upstream_sha, slugs)))
    upstream = {s: sha for s, sha in results.items() if sha}
    return {"outdated": sorted(upstream), "upstream": upstream,
            "failed": sorted(s for s, sha in results.items() if sha is None)}


def run(cmd):
    p = subprocess.run(cmd, capture_output=True, text=True, stdin=subprocess.DEVNULL)
    return {"ok": p.returncode == 0, "error": (p.stderr or p.stdout).strip()[-400:] if p.returncode else ""}


def need_slug(arg):
    if not SLUG_OK.match(arg or ""):
        sys.exit("bad theme name")
    return arg


def toggle_favorite(slug):
    need_slug(slug)
    os.makedirs(STATE, exist_ok=True)
    # Two quick toggles are two processes; the lock keeps one from undoing the other.
    with open(f"{STATE}/.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        favs = favorites() ^ {slug}
        write_atomic(f"{STATE}/favorites.json", json.dumps(sorted(favs)))
    return {"ok": True, "favorite": slug in favs}


# ── settings: bar icon, menu entry, shortcut ────────────────────────────────

def write_atomic(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.tmp{os.getpid()}"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, path)


def read_text(path):
    try:
        return open(path).read()
    except OSError:
        return ""


def entry_id(e):
    if isinstance(e, str):
        return e
    return e.get("id") if isinstance(e, dict) else None


DEFAULTS_JSON = f"{os.environ.get('OMARCHY_PATH', '/usr/share/omarchy')}/config/omarchy/shell.json"


def load_shell_json(strict=False):
    """The user's shell.json.

    A missing or empty file means Omarchy's defaults, so a writer starts from
    those rather than replacing them with a bare layout. A file that cannot be
    read or parsed is never replaced: writers (strict) stop with an error,
    readers just see nothing."""
    try:
        text = open(SHELL_JSON).read()
    except FileNotFoundError:
        text = ""
    except OSError as e:
        if strict:
            sys.exit(f"cannot read {SHELL_JSON}: {e}")
        return {}
    if not text.strip():
        try:
            return json.load(open(DEFAULTS_JSON)) if strict else {}
        except (OSError, ValueError):
            return {}
    try:
        cfg = json.loads(text)
    except ValueError as e:
        if strict:
            sys.exit(f"shell.json is not valid JSON ({e}); leaving it untouched")
        return {}
    if not isinstance(cfg, dict):
        if strict:
            sys.exit("shell.json is not a JSON object; leaving it untouched")
        return {}
    return cfg


def bar_state():
    bar = load_shell_json().get("bar")
    layout = bar.get("layout") if isinstance(bar, dict) else None
    layout = layout if isinstance(layout, dict) else {}
    for section in ("left", "center", "right"):
        items = layout.get(section)
        ids = [entry_id(e) for e in items] if isinstance(items, list) else []
        if PLUGIN_ID in ids:
            return {"section": section, "index": ids.index(PLUGIN_ID), "count": len(ids)}
    return {"section": "hidden", "index": 0, "count": 0}


def reload_shell():
    if subprocess.run(["omarchy-shell", "shell", "reloadConfig"], capture_output=True).returncode:
        subprocess.run(["omarchy-shell", "-q", "shell", "rescanPlugins"], capture_output=True)


def save_shell_json(cfg):
    write_atomic(SHELL_JSON, json.dumps(cfg, indent=2, sort_keys=True, ensure_ascii=False) + "\n")
    reload_shell()


def layout_of(cfg):
    """bar.layout with all three sections present."""
    if not isinstance(cfg.get("bar"), dict):
        cfg["bar"] = {}
    if not isinstance(cfg["bar"].get("layout"), dict):
        cfg["bar"]["layout"] = {}
    layout = cfg["bar"]["layout"]
    for section in ("left", "center", "right"):
        if not isinstance(layout.get(section), list):
            layout[section] = []
    return layout


def plugins_of(cfg):
    if not isinstance(cfg.get("plugins"), list):
        cfg["plugins"] = []
    return cfg["plugins"]


def keep_plugin_enabled(cfg):
    """The popup itself lives under plugins[]; a bar widget alone would tie its
    "enabled" state to being on the bar, so hiding the icon would break summon."""
    plugins = plugins_of(cfg)
    if not any(entry_id(e) == PLUGIN_ID for e in plugins):
        plugins.append({"id": PLUGIN_ID})


def place(section, index=None):
    """Move the icon to `section` (None removes it from the bar) at `index` (None = end)."""
    cfg = load_shell_json(strict=True)
    layout = layout_of(cfg)
    entry = {"id": PLUGIN_ID}
    for sec in layout:
        kept = []
        for e in layout[sec]:
            if entry_id(e) == PLUGIN_ID:
                entry = e if isinstance(e, dict) else entry
            else:
                kept.append(e)
        layout[sec] = kept
    keep_plugin_enabled(cfg)
    if section:
        items = layout[section]
        items.insert(len(items) if index is None else max(0, min(index, len(items))), entry)
    save_shell_json(cfg)
    return {"ok": True}


def bar_set(section):
    if section == "hidden":
        return place(None)
    if section not in ("left", "center", "right"):
        sys.exit("section must be hidden, left, center or right")
    st = bar_state()
    return {"ok": True} if st["section"] == section else place(section)


def bar_move(delta):
    st = bar_state()
    if st["section"] == "hidden":
        sys.exit("the icon is not on the bar")
    # "count" includes the icon itself, so the last valid index is count - 1.
    target = max(0, min(st["count"] - 1, st["index"] + int(delta)))
    return {"ok": True} if target == st["index"] else place(st["section"], target)


MENU_BLOCK = re.compile(r"[ \t]*// \[extra-themes-browser-menu\].*?// \[/extra-themes-browser-menu\][ \t]*\n?", re.S)


def jsonc_valid(text):
    """Same tolerance as the shell's menu parser: whole-line comments and trailing commas."""
    text = re.sub(r"^\s*//[^\n]*(\n|$)", "", text, flags=re.M)
    text = re.sub(r",(\s*[}\]])", r"\1", text)
    try:
        return isinstance(json.loads(text or "{}"), dict)
    except ValueError:
        return False


def menu_state():
    return "// [extra-themes-browser-menu]" in read_text(MENU_FILE)


def menu_set(on):
    original = read_text(MENU_FILE)
    if not on and not MENU_BLOCK.search(original):
        return {"ok": True}                      # nothing to remove; don't touch the file
    text = MENU_BLOCK.sub("", original or "{\n}\n")
    if on:
        # The menu parser keeps only whole-line comments, so a trailing `// note`
        # makes the file unreadable for it already; say so instead of guessing.
        if original and not jsonc_valid(original):
            sys.exit("omarchy-menu.jsonc is not valid for the Omarchy menu parser "
                     "(inline // comments are not supported); fix it first")
        end = text.rstrip().rfind("}")
        if end < 0:
            sys.exit("menu extension file is not an object")
        head, tail = text[:end], text[end:]
        lines = head.split("\n")
        for i in range(len(lines) - 1, -1, -1):
            code = lines[i].strip()
            if not code or code.startswith("//"):
                continue
            if code not in ("{",) and not code.endswith(","):
                lines[i] = lines[i].rstrip() + ","
            break
        block = ("  // [extra-themes-browser-menu]\n  " + MENU_ENTRY + "\n  // [/extra-themes-browser-menu]\n")
        head = "\n".join(lines)
        head = head if head.endswith("\n") else head + "\n"
        text = head + block + tail
        if not jsonc_valid(text):
            sys.exit("refusing to write: menu file would not parse")
    write_atomic(MENU_FILE, text)
    return {"ok": True}


MODS = ("SUPER", "CTRL", "ALT", "SHIFT")
MOD_ALIASES = {"WIN": "SUPER", "META": "SUPER", "MOD4": "SUPER", "CONTROL": "CTRL", "MOD1": "ALT", "OPTION": "ALT"}
MOD_BITS = {"SHIFT": 1, "CTRL": 4, "ALT": 8, "SUPER": 64}
NAMED_KEYS = {"SPACE", "RETURN", "TAB", "COMMA", "PERIOD", "SLASH", "SEMICOLON", "MINUS", "EQUAL",
              "BRACKETLEFT", "BRACKETRIGHT", "GRAVE", "BACKSPACE", "DELETE", "INSERT", "HOME", "END",
              "PRIOR", "NEXT", "LEFT", "RIGHT", "UP", "DOWN", "PRINT"}
KEY_OK = re.compile(r"^([A-Z0-9]|F([1-9]|1[0-9]|2[0-4]))$")
BIND_BLOCK = re.compile(r"\n?-- \[extra-themes-browser-keybind\].*?-- \[/extra-themes-browser-keybind\]\n?", re.S)
BIND_LINE = re.compile(r'o\.bind\("([^"]+)", "' + re.escape(BIND_DESC) + '"')


def parse_combo(raw):
    """Normalize user text into 'SUPER + CTRL + T'. Strict: the result is written into Lua."""
    toks = [t for t in re.split(r"[\s+]+", (raw or "").upper()) if t]
    mods, key = set(), None
    for t in toks:
        t = MOD_ALIASES.get(t, t)
        if t in MODS:
            mods.add(t)
        elif key is None and (KEY_OK.match(t) or t in NAMED_KEYS):
            key = t
        else:
            sys.exit(f"unknown key or modifier: {t.lower()}")
    if not key:
        sys.exit("missing key, e.g. SUPER + CTRL + T")
    if not mods & {"SUPER", "CTRL", "ALT"}:
        sys.exit("use at least one of SUPER, CTRL or ALT")
    return " + ".join([m for m in MODS if m in mods] + [key]), sum(MOD_BITS[m] for m in mods), key


def current_shortcut():
    m = BIND_LINE.search(read_text(BINDINGS))
    return m.group(1) if m else ""


def conflict(mask, key):
    """Description of an existing Hyprland binding on the same keys, ignoring our own."""
    try:
        binds = json.loads(subprocess.run(["hyprctl", "binds", "-j"], capture_output=True, text=True, timeout=5).stdout)
    except Exception:
        return ""
    for b in binds:
        if b.get("description") == BIND_DESC:
            continue
        if b.get("key", "").upper() == key and (b.get("modmask", 0) & 0x4D) == mask:
            return b.get("description") or b.get("dispatcher") or "another binding"
    return ""


def hypr_errors():
    try:
        p = subprocess.run(["hyprctl", "configerrors"], capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired) as e:
        sys.exit(f"hyprctl is not available: {e}")
    return p.stdout.strip()


def shortcut_write(text, before_errors):
    """Write bindings.lua, reload, and roll back if Hyprland fails or reports new errors."""
    old = read_text(BINDINGS)
    write_atomic(BINDINGS, text)
    problem = ""
    try:
        subprocess.run(["hyprctl", "reload"], capture_output=True, timeout=10)
        for _ in range(3):                      # give a slow reload time to report
            time.sleep(0.4)
            after = hypr_errors()
            if after and after != before_errors:
                problem = "Hyprland rejected the binding: " + after[:200]
                break
    except (OSError, subprocess.TimeoutExpired) as e:
        problem = f"could not reload Hyprland: {e}"
    except SystemExit as e:
        problem = str(e.code)
    if problem:
        write_atomic(BINDINGS, old)
        try:
            subprocess.run(["hyprctl", "reload"], capture_output=True, timeout=10)
        except (OSError, subprocess.TimeoutExpired):
            pass
        sys.exit(problem)


def shortcut_set(raw):
    combo, mask, key = parse_combo(raw)
    other = conflict(mask, key)
    if other:
        sys.exit(f"{combo} is already used by “{other}”")
    text = BIND_BLOCK.sub("\n", read_text(BINDINGS)).rstrip("\n") + "\n"
    text += (f'\n-- [extra-themes-browser-keybind]\no.bind("{combo}", "{BIND_DESC}", "{BIND_CMD}")\n'
             "-- [/extra-themes-browser-keybind]\n")
    shortcut_write(text, hypr_errors())
    return {"ok": True}


def shortcut_clear():
    if not BIND_BLOCK.search(read_text(BINDINGS)):
        return {"ok": True}
    text = BIND_BLOCK.sub("\n", read_text(BINDINGS)).rstrip("\n") + "\n"
    shortcut_write(text, hypr_errors())
    return {"ok": True}


def suggest_shortcut():
    for cand in ("SUPER + CTRL + T", "SUPER + ALT + T", "SUPER + CTRL + E", "SUPER + CTRL + ALT + T"):
        _, mask, key = parse_combo(cand)
        if not conflict(mask, key):
            return cand
    return ""


PREFS_FILE = f"{STATE}/settings.json"
NOTIFIED_FILE = f"{STATE}/notified.json"
LAST_CHECK_FILE = f"{STATE}/last-check.json"
CHECK_INTERVAL = 24 * 3600
NOTIFY_GLYPH = "\U000F03D8"


def read_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def prefs():
    data = read_json(PREFS_FILE, {})
    return data if isinstance(data, dict) else {}


def notify_enabled():
    return prefs().get("notifyUpdates") is True


def notify_set(on):
    data = prefs()
    data["notifyUpdates"] = bool(on)
    write_atomic(PREFS_FILE, json.dumps(data))
    if on:
        # Turning it on should not wait out a day-long window from an old check.
        try:
            os.remove(LAST_CHECK_FILE)
        except OSError:
            pass
    return {"ok": True}


def display_name(slug):
    """Catalog name if cached, else the folder name made readable."""
    for t in read_json(f"{CACHE}/catalog.json", []):
        if isinstance(t, dict) and t.get("slug") == slug and t.get("name"):
            return t["name"]
    return slug.replace("-", " ").title()


def send_update_notification(slugs):
    names = [display_name(s) for s in slugs]
    if len(names) == 1:
        headline, body = f"{names[0]} has an update", "Open Extra Themes to update it."
    else:
        shown = ", ".join(names[:4]) + (f" and {len(names) - 4} more" if len(names) > 4 else "")
        headline, body = f"{len(names)} themes have updates", shown
    p = subprocess.run(
        ["omarchy-notification-send", "--app-name", "Extra Themes", "-g", NOTIFY_GLYPH, headline, body,
         "--exec", "omarchy-shell", "shell", "summon", PLUGIN_ID],
        capture_output=True, text=True, timeout=15, stdin=subprocess.DEVNULL)
    return p.returncode == 0


def check_updates(force=False):
    """Called hourly by the plugin's service, but only looks at most once a day.
    Notifies once per new upstream commit of each installed theme, and does no
    network work at all while notifications are off or the last check is recent."""
    if not notify_enabled():
        return {"ok": True, "skipped": "disabled"}
    stamp = read_json(LAST_CHECK_FILE, {})
    last = stamp.get("at") if isinstance(stamp, dict) else None
    if not force and isinstance(last, (int, float)) and 0 <= time.time() - last < CHECK_INTERVAL:
        return {"ok": True, "skipped": "checked recently"}
    result = status()
    current, failed = result["upstream"], set(result["failed"])
    seen = read_json(NOTIFIED_FILE, {})
    seen = seen if isinstance(seen, dict) else {}
    fresh = sorted(s for s, sha in current.items() if seen.get(s) != sha)
    # Forget themes that are no longer behind, so a later update notifies again, but
    # keep the ones we could not reach (offline): they would be announced twice.
    keep = {s: sha for s, sha in seen.items() if s in current or s in failed}
    if fresh:
        try:
            sent = send_update_notification(fresh)
        except (OSError, subprocess.TimeoutExpired):
            sent = False
        if not sent:
            # Not recorded as checked, so the next hourly wake-up tries again.
            write_atomic(NOTIFIED_FILE, json.dumps(keep))
            return {"ok": False, "error": "could not send the notification", "outdated": sorted(current)}
        keep.update({s: current[s] for s in fresh})
    write_atomic(NOTIFIED_FILE, json.dumps(keep))
    if failed:
        # Part of the picture is missing, so this was not a real check: try again next hour.
        return {"ok": True, "outdated": sorted(current), "notified": fresh, "unreachable": sorted(failed)}
    write_atomic(LAST_CHECK_FILE, json.dumps({"at": time.time()}))
    return {"ok": True, "outdated": sorted(current), "notified": fresh}


def cleanup():
    """Undo everything this plugin wrote outside its own folder, so that
    `omarchy plugin remove` leaves nothing dangling. Each step is attempted even
    if an earlier one fails, and the failures are reported together."""
    errors = []

    def step(fn, *a):
        try:
            fn(*a)
        except SystemExit as e:
            errors.append(str(e.code))
        except Exception as e:
            errors.append(f"{type(e).__name__}: {e}")

    def unregister():
        cfg = load_shell_json(strict=True)
        layout = layout_of(cfg)
        for sec in layout:
            layout[sec] = [e for e in layout[sec] if entry_id(e) != PLUGIN_ID]
        cfg["plugins"] = [e for e in plugins_of(cfg) if entry_id(e) != PLUGIN_ID]
        save_shell_json(cfg)

    step(menu_set, False)
    step(shortcut_clear)
    step(unregister)
    for d in (CACHE, STATE):
        shutil.rmtree(d, ignore_errors=True)
    return {"ok": not errors, "error": "; ".join(errors)}


def settings():
    return {"bar": bar_state(), "menu": menu_state(), "shortcut": current_shortcut(),
            "suggested": suggest_shortcut(), "notify": notify_enabled()}


WRITES_CONFIG = {"bar", "bar-move", "menu", "shortcut-set", "shortcut-clear", "notify", "cleanup"}


class config_lock:
    """Serialises commands that edit shell.json, the menu file or bindings.lua: the popup
    fires one process per key press, and two read-modify-write cycles must not interleave."""

    def __enter__(self):
        os.makedirs(STATE, exist_ok=True)
        self.f = open(f"{STATE}/.config.lock", "w")
        fcntl.flock(self.f, fcntl.LOCK_EX)

    def __exit__(self, *exc):
        self.f.close()


def main(argv):
    cmd = argv[1] if len(argv) > 1 else ""
    if cmd in WRITES_CONFIG:
        with config_lock():
            return dispatch(argv)
    return dispatch(argv)


def dispatch(argv):
    cmd, args = (argv[1] if len(argv) > 1 else ""), argv[2:]
    if cmd == "catalog":
        res = catalog("--refresh" in args)
    elif cmd == "status":
        res = status()
    elif cmd == "install":
        # URL must come from the catalog, not an arbitrary caller.
        known = {t["repo"] for t in fetch_catalog(False)}
        if not args or args[0] not in known:
            sys.exit("repo not in catalog")
        res = run(["omarchy", "theme", "install", args[0]])
    elif cmd == "uninstall":
        # Only clones are ours to delete; a same-named hand-made theme is not.
        if not is_git_theme(need_slug(args[0] if args else "")):
            sys.exit("not an installed git theme")
        # Removing the active theme would leave the desktop on a deleted one.
        was_active = active_slug() == args[0]
        res = run(["omarchy", "theme", "remove", args[0]])
        if res["ok"] and was_active:
            back = run(["omarchy", "theme", "set", DEFAULT_THEME])
            if back["ok"]:
                res["switched"] = DEFAULT_THEME
            else:
                res = {"ok": False, "error": f"Removed, but could not switch to {DEFAULT_THEME}: {back['error']}"}
    elif cmd == "update":
        need_slug(args[0] if args else "")
        res = run(["git", "-C", f"{THEMES}/{args[0]}", "pull", "--ff-only", "--quiet"]) if is_git_theme(args[0]) else {"ok": False, "error": "not a git theme"}
    elif cmd == "apply":
        res = run(["omarchy", "theme", "set", need_slug(args[0] if args else "")])
    elif cmd == "open-folder":
        os.makedirs(THEMES, exist_ok=True)
        subprocess.Popen(["xdg-open", THEMES], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        res = {"ok": True}
    elif cmd == "settings":
        res = settings()
    elif cmd == "bar":
        res = bar_set(args[0] if args else "")
    elif cmd == "bar-move":
        res = bar_move(args[0] if args else "0")
    elif cmd == "menu":
        res = menu_set((args[0] if args else "") == "on")
    elif cmd == "shortcut-set":
        res = shortcut_set(args[0] if args else "")
    elif cmd == "notify":
        res = notify_set((args[0] if args else "") == "on")
    elif cmd == "check-updates":
        res = check_updates(force="--force" in args)
    elif cmd == "cleanup":
        res = cleanup()
    elif cmd == "shortcut-clear":
        res = shortcut_clear()
    elif cmd == "favorite":
        res = toggle_favorite(args[0] if args else "")
    else:
        sys.exit(__doc__)
    print(json.dumps(res))


if __name__ == "__main__":
    try:
        main(sys.argv)
    except SystemExit as e:
        print(json.dumps({"ok": False, "error": str(e.code)}))
        sys.exit(1)
    except Exception as e:
        print(json.dumps({"ok": False, "error": f"{type(e).__name__}: {e}"}))
        sys.exit(1)
